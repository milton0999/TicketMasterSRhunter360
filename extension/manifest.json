{
  "manifest_version": 3,
  "name": "TicketMasterSRhunter360",
  "version": "1.0.0",
  "description": "Shift ticket monitor — TicketMasterSRhunter360",
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon":  "icon48.png",
    "default_title": "TicketMasterSRhunter360"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
